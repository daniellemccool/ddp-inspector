# Local config with environment-specific (and possibly sensitive) paths
config.php

# Optional runtime stats cache
.cache/

# Never commit donor data
*-tiktok.json
inbox/
transcripts/

# Synthetic test fixtures must be committed despite the donor-data patterns above
!tests/fixtures/
!tests/fixtures/**/
!tests/fixtures/**

# Synthetic example dataset (examples/generate.py) must be committed despite
# the donor-data patterns above
!examples/ddp/*.json
!examples/transcripts/
!examples/transcripts/**/
!examples/transcripts/**
