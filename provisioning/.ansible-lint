---
profile: moderate

exclude_paths:
  - ../.git/
  - .venv/
  - .venv-lint/

skip_list:
  # Cross-role facts are this component's design: preflight derives
  # storage_root/inspector_root/php_fpm_service and later roles consume
  # them. Role-prefixing shared facts would obscure, not clarify.
  - var-naming[no-role-prefix]
