# Generated by the ddp-inspector component — do not edit.
# Fires daily; the refresh script itself exits immediately unless the
# study's schedule (instance.json cadence) is "daily" or a run was
# explicitly requested — so an always-on timer stays a no-op for
# manual-refresh studies.
[Unit]
Description=Scheduled DDP Inspector refresh (no-op unless cadence=daily)

[Timer]
OnCalendar=daily
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
