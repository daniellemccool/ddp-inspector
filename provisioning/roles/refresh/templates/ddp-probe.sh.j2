#!/usr/bin/env bash
# Generated by the ddp-inspector component — do not edit.
# Fast connection probe for the app's "Test connection" button (seconds, not
# minutes — never pulls data). Usage: ddp-probe.sh {yoda|rd-link|local}.
# Exit 0 = reachable; exit 1 + a researcher-facing line on stdout otherwise.
set -uo pipefail

ROOT="{{ inspector_root }}"
GOCMD="{{ gocmd_bin | default('/usr/local/bin/gocmd') }}"
RCLONE="{{ rclone_bin | default('/usr/local/bin/rclone') }}"
SOURCE="${ROOT}/config/source.json"
INSTANCE="${ROOT}/config/instance.json"

case "${1:-}" in
  yoda)
    [ -f "${SOURCE}" ] || { echo "No access code saved yet."; exit 1; }
    GDIR="$(mktemp -d)"; trap 'rm -rf "${GDIR}"' EXIT
    HOST="$(jq -r '.host' "${SOURCE}")"; ZONE="$(jq -r '.zone' "${SOURCE}")"
    cat > "${GDIR}/irods_environment.json" <<EOF
{
  "irods_host": "${HOST}",
  "irods_port": 1247,
  "irods_zone_name": "${ZONE}",
  "irods_client_zone_name": "${ZONE}",
  "irods_user_name": "anonymous",
  "irods_client_user_name": "anonymous",
  "irods_authentication_scheme": "native",
  "irods_default_hash_scheme": "SHA256",
  "irods_client_server_policy": "CS_NEG_REQUIRE",
  "irods_client_server_negotiation": "request_server_negotiation",
  "irods_ssl_verify_server": "hostname"
}
EOF
    if "${GOCMD}" ls -c "${GDIR}" -T "$(jq -r '.ticket' "${SOURCE}")" \
         "i:$(jq -r '.collection' "${SOURCE}")" >/dev/null 2>&1; then
      echo "Connected."
    else
      echo "Could not connect — the access code may have expired or been revoked. Ask your data manager for a new one."
      exit 1
    fi
    ;;
  rd-link)
    [ -f "${SOURCE}" ] || { echo "No share link saved yet."; exit 1; }
    if "${RCLONE}" lsd :webdav: \
         --webdav-url "$(jq -r '.webdav_url' "${SOURCE}")" \
         --webdav-vendor owncloud \
         --webdav-user "$(jq -r '.share_token' "${SOURCE}")" \
         --webdav-pass "$("${RCLONE}" obscure "$(jq -r '.password' "${SOURCE}")")" \
         >/dev/null 2>&1; then
      echo "Connected."
    else
      echo "Could not open the share link — it may have expired or the password may be wrong. Create a new share link and paste it here."
      exit 1
    fi
    ;;
  local)
    P="$(jq -r '.local_path // ""' "${INSTANCE}" 2>/dev/null)"
    if [ -n "${P}" ] && [ -d "${P}" ] && [ -r "${P}" ]; then
      echo "Folder found ($(find -L "${P}" -maxdepth 1 -name '*.json' | wc -l | tr -d ' ') donation files)."
    else
      echo "That folder is missing or unreadable on this workspace."
      exit 1
    fi
    ;;
  *)
    echo "usage: ddp-probe.sh {yoda|rd-link|local}" >&2
    exit 2
    ;;
esac
