#!/usr/bin/env bash
# Generated by the ddp-inspector component — do not edit.
# Source-mode-dispatching refresh: reads the study config the app's setup
# wizard wrote onto the volume, pulls donations (and transcript shards, yoda
# mode) into the local tree, and reports progress through refresh-status.json
# in RESEARCHER-FACING plain language (spec §2/§6) — this file's messages are
# rendered directly in the web UI. Serialized by flock; safe to re-run.
set -uo pipefail

ROOT="{{ inspector_root }}"
GOCMD="{{ gocmd_bin | default('/usr/local/bin/gocmd') }}"
RCLONE="{{ rclone_bin | default('/usr/local/bin/rclone') }}"
INSTANCE="${ROOT}/config/instance.json"
SOURCE="${ROOT}/config/source.json"
STATE="${ROOT}/state"
FLAG="${STATE}/refresh-requested"
STATUS="${STATE}/refresh-status.json"
LOG="${STATE}/refresh.log"
INBOX="${ROOT}/data/inbox"
TRANSCRIPTS="${ROOT}/data/analyses/transcripts"
CACHE="${ROOT}/cache"
# Analysis database mode (Setup: analyses.database): the one file the app reads.
DB="${ROOT}/data/analyses/analysis.sqlite"
DBSTAGE="${ROOT}/data/analyses/.analysis-db-staging"   # same filesystem: mv is a rename
DBREMOTE="${STATE}/analysis-db.remote"                  # remote listing at the last fetch

# Not configured yet (wizard not completed): quietly nothing to do. A
# refresh requested before setup completes is legitimately droppable — but
# the flag MUST be consumed here, or systemd's PathExists= unit re-triggers
# on every deactivation with the flag still present, loops to the start-rate
# limit, and the path unit fails (requiring an operator to reset it).
[ -f "${INSTANCE}" ] || { rm -f "${FLAG}"; exit 0; }

# Flag present = requested run (button or fresh config). No flag = timer
# tick: run only when the researcher chose a daily schedule.
REQUESTED=0
[ -e "${FLAG}" ] && REQUESTED=1
CADENCE="$(jq -r '.cadence // "off"' "${INSTANCE}")"
if [ "${REQUESTED}" -eq 0 ] && [ "${CADENCE}" != "daily" ]; then exit 0; fi

exec 9> "${STATE}/.refresh.lock"
flock 9
rm -f "${FLAG}"
: > "${LOG}"
exec >> "${LOG}" 2>&1

STARTED="$(date -u +%FT%TZ)"
write_status() { # write_status <phase> <finished|-> <donations|-> <message>
  local phase="$1" finished="$2" donations="$3" message="$4" tmp
  tmp="$(mktemp "${STATE}/.status.XXXXXX")"
  jq -n --arg phase "${phase}" --arg started "${STARTED}" \
        --arg finished "${finished}" --arg donations "${donations}" \
        --arg message "${message}" \
        '{phase: $phase, started_at: $started,
          finished_at: (if $finished == "-" then null else $finished end),
          donations: (if $donations == "-" then null else ($donations | tonumber) end),
          message: $message}' > "${tmp}"
  mv "${tmp}" "${STATUS}"
}
die() { # die <researcher-facing message>
  echo "[refresh] ERROR: $1"
  rm -rf "${DBSTAGE}"   # never leave a half-downloaded database behind
  write_status error "$(date -u +%FT%TZ)" - "$1"
  exit 1
}
count_donations() { find -L "${INBOX}" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l | tr -d ' '; }
ensure_real_inbox_dir() { # before anything writes into the inbox: strip a
  # local-mode symlink, so a source-mode switch (or a local folder that now
  # holds an export) never syncs/mirrors/unpacks through it into whatever
  # folder it pointed at. Unlinking a symlink only removes the link itself —
  # it never touches the target folder's contents.
  [ -L "${INBOX}" ] && rm -f "${INBOX}"
  mkdir -p "${INBOX}"
}
newest_zip() { # newest_zip <dir>: the newest <YYYYMMDD>_<study>.zip in it, or nothing
  find -L "$1" -maxdepth 1 -type f -name '*.zip' 2>/dev/null | sort | tail -n 1
}
extract_export_zip() { # extract_export_zip <zip>: a Next export -> the inbox
  # Each export is a full snapshot, so the newest one IS the study's current
  # state: extract only its donation files (…_source=…), not onboarding
  # answers or Next preview-mode test donations, and mirror them into the
  # inbox so a withdrawn donation disappears as well. Reads the zip only.
  local zip="$1" stage="${ROOT}/data/.inbox-staging" rc
  ensure_real_inbox_dir
  write_status extracting - - "Unpacking donations…"
  rm -rf "${stage}"; mkdir -p "${stage}"
  # Next's export zips trip unzip 6.0's overlapped-components "zip bomb"
  # check although every entry is intact (live finding 2026-11-20 on a
  # real Next export), so that check is off: the zip is the study's own
  # export from its data manager, not an untrusted upload. They also
  # store no permission bits (unzip writes mode-000 files nobody can
  # read), hence the chmod. -j flattens the study folder and rules out
  # path traversal; exit 11 = no matching entries (no donations yet).
  UNZIP_DISABLE_ZIPBOMB_DETECTION=TRUE \
    unzip -q -j -o "${zip}" '*_source=*.json' -x '*_participant=preview_*' -d "${stage}"
  rc=$?
  [ "${rc}" -eq 0 ] || [ "${rc}" -eq 11 ] \
    || die "Unpacking donations failed. Try refreshing again."
  find "${stage}" -maxdepth 1 -type f -name '*.json' -exec chmod 0644 {} +
  echo "[refresh] extracted $(find "${stage}" -maxdepth 1 -type f -name '*.json' | wc -l | tr -d ' ') donation file(s) from $(basename "${zip}")"
  find "${INBOX}" -maxdepth 1 -type f -name '*.json' -delete
  find "${stage}" -maxdepth 1 -type f -name '*.json' -exec mv -t "${INBOX}" {} +
  rm -rf "${stage}"
}
link_inbox_to() { # link_inbox_to <folder>: local mode, the inbox IS that folder
  if [ -L "${INBOX}" ]; then
    # Already a symlink: only touch it if the target changed — removing/
    # replacing a symlink never touches the old target's contents.
    [ "$(readlink "${INBOX}")" = "$1" ] || { rm -f "${INBOX}"; ln -s "$1" "${INBOX}"; }
  else
    rm -rf "${INBOX}"   # our own real dir (an earlier pull), never a configured folder
    ln -s "$1" "${INBOX}"
  fi
}
db_missing() {
  die "The analysis database was not found at ${DBPATH} in the study folder. Check the path in Settings."
}
fetch_db() { # fetch_db <source> <listing> <download function>: yoda/rd-link database mode
  # Download only when the remote listing (size + modification time, as the
  # remote prints it) differs from the one stored at the last fetch, or the
  # file is not here (a local-mode symlink counts as not here). The download
  # goes to a staging dir on the same filesystem and is renamed into place,
  # so the pages never see a partial file: a page open mid-swap keeps
  # reading the old inode. The listing is stored only after the swap.
  local listing="$2" get="$3" stored got
  stored="$(printf '%s %s\n%s' "$1" "${DBPATH}" "${listing}")"
  rm -rf "${DBSTAGE}"
  mkdir -p "$(dirname "${DB}")"
  if [ -f "${DB}" ] && [ ! -L "${DB}" ] && [ -f "${DBREMOTE}" ] \
     && [ "$(cat "${DBREMOTE}")" = "${stored}" ]; then
    DBNOTE="The analysis database is up to date."
    write_status pulling - - "${DBNOTE}"
    echo "[refresh] analysis database up to date"
    return
  fi
  write_status pulling - - "Fetching the analysis database…"
  mkdir -p "${DBSTAGE}"
  "${get}" || die "Fetching the analysis database stopped partway. This is usually temporary — try again in a few minutes."
  got="${DBSTAGE}/$(basename "${DBPATH}")"
  [ -f "${got}" ] || die "Fetching the analysis database stopped partway. This is usually temporary — try again in a few minutes."
  chmod 0644 "${got}"
  # -T: replace whatever is at the target (file or symlink) by this rename;
  # never move into, or write through, what a symlink points at.
  mv -fT "${got}" "${DB}" || die "Could not put the analysis database in place. Try refreshing again."
  rm -rf "${DBSTAGE}"
  printf '%s\n' "${stored}" > "${DBREMOTE}.tmp" && mv -f "${DBREMOTE}.tmp" "${DBREMOTE}"
  echo "[refresh] fetched the analysis database ($(stat -c %s "${DB}") bytes)"
}
link_db_to() { # link_db_to <file>: local database mode, a symlink, never a copy
  # Safe because the pipeline replaces its database by rename, never in place.
  [ -f "$1" ] && [ -r "$1" ] || db_missing
  mkdir -p "$(dirname "${DB}")"
  rm -f "${DBREMOTE}"   # nothing downloaded: a later download mode fetches afresh
  [ -L "${DB}" ] && [ "$(readlink "${DB}")" = "$1" ] && return
  rm -rf "${DBSTAGE}"; mkdir -p "${DBSTAGE}"
  ln -s "$1" "${DBSTAGE}/link"
  mv -fT "${DBSTAGE}/link" "${DB}" || die "Could not put the analysis database in place. Try refreshing again."
  rm -rf "${DBSTAGE}"
}

MODE="$(jq -r '.source_mode // ""' "${INSTANCE}")"
# Database mode: the path of the declared analysis database file, relative
# to the study folder (validated at save: relative, no ..); empty = not declared.
DBPATH="$(jq -r '.analyses.database | select(.enabled) | .path // empty' "${INSTANCE}" 2>/dev/null)"
DBNOTE=""
echo "[refresh] $(date -u +%FT%TZ) mode=${MODE} requested=${REQUESTED} cadence=${CADENCE}"

case "${MODE}" in
  yoda)
    [ -f "${SOURCE}" ] || die "The data connection is not set up yet — open Setup and enter your Yoda login."
    COLLECTION="$(jq -r '.collection // ""' "${SOURCE}")"
    YODA_PASSWORD="$(jq -r '.password // ""' "${SOURCE}")"
    # A source.json from the old anonymous-ticket design has no configuration
    # or password (Yoda has no anonymous login; that design never worked).
    jq -e '.env | type == "object"' "${SOURCE}" >/dev/null 2>&1 && [ -n "${YODA_PASSWORD}" ] \
      || die "Yoda needs your own login — open Setup, add your Yoda configuration (upload or paste) and data access password, and save."
    # The researcher's own configuration as pasted from the Yoda portal,
    # written out unchanged into a private per-run config dir. The data
    # access password never goes into a file or argv: gocmd v0.12.2 reads
    # IRODS_USER_PASSWORD instead of prompting. Keep in sync with
    # inst_gocmd_config() and ddp-probe.sh.j2.
    GDIR="$(mktemp -d)"; trap 'rm -rf "${GDIR}"' EXIT
    jq '.env' "${SOURCE}" > "${GDIR}/irods_environment.json"
    gc() { # gc <subcommand> <args…>: gocmd logged in as this study's Yoda user
      local sub="$1"; shift
      IRODS_USER_PASSWORD="${YODA_PASSWORD}" "${GOCMD}" "${sub}" -c "${GDIR}" "$@"
    }
    write_status probing - - "Checking the connection to the data store…"
    if ! PROBE_OUT="$(gc ls "i:${COLLECTION}" 2>&1)"; then
      echo "${PROBE_OUT}"
      if grep -qi 'authentication failed' <<<"${PROBE_OUT}"; then
        die "Yoda did not accept your username and data access password. Data access passwords expire — create a new one in the Yoda portal, paste it in Setup, and try again."
      elif grep -qi 'failed to establish a connection' <<<"${PROBE_OUT}"; then
        die "Could not reach Yoda from this workspace. This is usually temporary — try again in a few minutes."
      else
        die "Logged in to Yoda, but could not open the folder. Check the folder path in Setup — it is the full path, starting with /nluu10p/home/."
      fi
    fi
    if [ -n "${DBPATH}" ]; then
      # Database mode: only the database file; no donations, no transcripts.
      # Change detection compares the listing ourselves (not get --diff).
      DBSRC="i:${COLLECTION}/${DBPATH}"
      LISTING="$(gc ls -l "${DBSRC}")" && [ -n "${LISTING}" ] || db_missing
      get_db_yoda() { gc get -f "${DBSRC}" "${DBSTAGE}"; }
      fetch_db "yoda ${COLLECTION}" "${LISTING}" get_db_yoda
    else
      write_status pulling - - "Fetching donations…"
      ensure_real_inbox_dir
      # get -f, not sync: in the old ticket design gocmd v0.12.2's sync
      # rejected -T (live finding 2026-07-30). sync with a pam_password login
      # is not verified live yet, so keep get -f: it re-downloads instead of
      # delta-syncing; acceptable at donation scale.
      # Under the study folder: inbox/, else the newest donations/ export. No
      # "folder itself is the inbox" rule here, unlike rd-link/local: a Yoda
      # collection never held loose donations, and Yoda folders carry their
      # own yoda-metadata.json at the top.
      if gc ls "i:${COLLECTION}/inbox" >/dev/null 2>&1; then
        # Loose donation files in <collection>/inbox (the original layout).
        gc get -f "i:${COLLECTION}/inbox" "${ROOT}/data" \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
      elif gc ls "i:${COLLECTION}/donations" >/dev/null 2>&1; then
        # Next export zips in <collection>/donations/<YYYYMMDD>_<study>.zip;
        # the newest one wins (extract_export_zip).
        rm -rf "${CACHE}/donations"
        gc get -f "i:${COLLECTION}/donations" "${CACHE}" \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
        ZIP="$(newest_zip "${CACHE}/donations")"
        [ -n "${ZIP}" ] \
          || die "The donations folder on the data store has no export in it yet — ask your data manager to upload the latest export, then try again."
        extract_export_zip "${ZIP}"
        rm -rf "${CACHE}/donations"
      else
        die "No donations were found in that folder on the data store. Check the folder path in Setup with your data manager."
      fi
      # Transcripts: prefer a server-side extracted tree if it ever appears
      # (FSW-unblock optimization); otherwise pull shard tars and extract
      # locally (the required path while server-side extraction is blocked).
      if gc ls "i:${COLLECTION}/transcripts" >/dev/null 2>&1; then
        write_status pulling - - "Fetching transcripts…"
        gc get -f "i:${COLLECTION}/transcripts" "${ROOT}/data/analyses" \
          || die "Fetching transcripts stopped partway. Try again in a few minutes."
      elif gc ls "i:${COLLECTION}/transcripts-tars" >/dev/null 2>&1; then
        write_status pulling - - "Fetching transcript bundles…"
        gc get -f "i:${COLLECTION}/transcripts-tars" "${CACHE}" \
          || die "Fetching transcript bundles stopped partway. Try again in a few minutes."
        write_status extracting - - "Unpacking transcripts…"
        mkdir -p "${TRANSCRIPTS}"
        for t in "${CACHE}/transcripts-tars"/shard-*.tar; do
          [ -f "${t}" ] || continue
          tar -xf "${t}" -C "${TRANSCRIPTS}" || die "Unpacking transcripts failed. Try refreshing again."
          rm -f "${t}"   # prune after successful extract (cache holds partial pulls only)
        done
      else
        echo "[refresh] no transcripts on the data store (yet) — donations only"
      fi
    fi
    ;;
  rd-link)
    [ -f "${SOURCE}" ] || die "The data connection is not set up yet — open Setup and paste your Research Drive share link."
    URL="$(jq -r '.webdav_url' "${SOURCE}")"
    TOKEN="$(jq -r '.share_token' "${SOURCE}")"
    PASS_OBSCURED="$("${RCLONE}" obscure "$(jq -r '.password' "${SOURCE}")")"
    RFLAGS=(--webdav-url "${URL}" --webdav-vendor owncloud
            --webdav-user "${TOKEN}" --webdav-pass "${PASS_OBSCURED}")
    write_status probing - - "Checking the connection to Research Drive…"
    # The listing of the shared (study) folder doubles as the connection
    # check: dirs come back with a trailing /, files without.
    TOP="$("${RCLONE}" lsf :webdav: "${RFLAGS[@]}")" \
      || die "Could not open the Research Drive share link. The link may have expired or the password may be wrong — create a new share link, paste it in Setup, and try again."
    if [ -n "${DBPATH}" ]; then
      # Database mode: only that file. lsl prints "<size> <date> <time> <name>".
      LISTING="$("${RCLONE}" lsl ":webdav:${DBPATH}" "${RFLAGS[@]}")" && [ -n "${LISTING}" ] || db_missing
      get_db_rd() { "${RCLONE}" copy ":webdav:${DBPATH}" "${DBSTAGE}" "${RFLAGS[@]}"; }
      fetch_db "rd-link" "${LISTING}" get_db_rd
    else
      write_status pulling - - "Fetching donations…"
      ensure_real_inbox_dir
      # Under the shared folder: donation files right in it (a share of the
      # donations folder itself, as before), else inbox/, else the newest
      # donations/ export. --max-depth 1: the inbox is flat, never pull a
      # subfolder's files along.
      if grep -q '\.json$' <<<"${TOP}"; then
        "${RCLONE}" sync :webdav: "${INBOX}" "${RFLAGS[@]}" --include '*.json' --max-depth 1 \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
      elif grep -qx 'inbox/' <<<"${TOP}"; then
        "${RCLONE}" sync :webdav:inbox "${INBOX}" "${RFLAGS[@]}" --include '*.json' --max-depth 1 \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
      elif grep -qx 'donations/' <<<"${TOP}"; then
        ZIPS="$("${RCLONE}" lsf :webdav:donations "${RFLAGS[@]}" --files-only --include '*.zip')" \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
        ZIP="$(sort <<<"${ZIPS}" | tail -n 1)"
        [ -n "${ZIP}" ] \
          || die "The donations folder in the share has no export in it yet — ask your data manager to upload the latest export, then try again."
        rm -rf "${CACHE}/donations"
        "${RCLONE}" copy ":webdav:donations/${ZIP}" "${CACHE}/donations" "${RFLAGS[@]}" \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
        [ -f "${CACHE}/donations/${ZIP}" ] \
          || die "Fetching donations stopped partway. This is usually temporary — try again in a few minutes."
        extract_export_zip "${CACHE}/donations/${ZIP}"
        rm -rf "${CACHE}/donations"
      else
        die "No donations were found in the shared folder. Check with your data manager that the share link points at the study's folder."
      fi
    fi
    ;;
  local)
    LOCAL_PATH="$(jq -r '.local_path // ""' "${INSTANCE}")"
    [ -n "${LOCAL_PATH}" ] && [ -d "${LOCAL_PATH}" ] && [ -r "${LOCAL_PATH}" ] \
      || die "The configured folder (${LOCAL_PATH:-not set}) is missing or unreadable on this workspace — an operator needs to check the Setup 'folder on this workspace' path."
    if [ -n "${DBPATH}" ]; then
      # Database mode: link to the folder's database; nothing is copied and
      # nothing inside the configured folder is ever written.
      link_db_to "${LOCAL_PATH}/${DBPATH}"
    else
      # Under the configured (study) folder: donation files right in it (a
      # pipeline inbox, as before) or in inbox/ -> the inbox is a symlink to
      # that folder; else the newest donations/ export, unpacked into a real
      # inbox dir. Nothing inside the configured folder is ever written.
      if [ -n "$(find -L "${LOCAL_PATH}" -maxdepth 1 -type f -name '*.json' -print -quit 2>/dev/null)" ]; then
        link_inbox_to "${LOCAL_PATH}"
      elif [ -d "${LOCAL_PATH}/inbox" ]; then
        link_inbox_to "${LOCAL_PATH}/inbox"
      elif [ -d "${LOCAL_PATH}/donations" ]; then
        ZIP="$(newest_zip "${LOCAL_PATH}/donations")"
        [ -n "${ZIP}" ] \
          || die "The donations folder has no export in it yet — ask your data manager to add the latest export, then try again."
        extract_export_zip "${ZIP}"
      else
        die "No donations were found in that folder on this workspace. Check the folder in Setup — it should be the study's folder."
      fi
    fi
    ;;
  *)
    die "The study setup looks incomplete — open Setup and finish the 'Where are your donations stored?' step."
    ;;
esac

# Warm the participant-list cache so the first page view after a refresh is fast.
# A failed warm-up never fails the refresh: fall back to counting the files.
# In database mode the count is the participants who donated, from the
# database; the inbox may hold an older pull, so there is no fallback count.
if N="$({{ inspector_php_bin | default('php') }} {{ inspector_install_dir }}/bin/warm-cache.php | tail -n 1)" && [[ "${N}" =~ ^[0-9]+$ ]]; then
  MSG="${DBNOTE:+${DBNOTE} }Found ${N} donation(s)."
else
  echo "[refresh] cache warm-up failed"
  if [ -n "${DBPATH}" ]; then
    N="-"; MSG="${DBNOTE:-The analysis database is ready.}"
  else
    N="$(count_donations)"; MSG="Found ${N} donation(s)."
  fi
fi
write_status done "$(date -u +%FT%TZ)" "${N}" "${MSG}"
echo "[refresh] done: ${N} donation(s)"
