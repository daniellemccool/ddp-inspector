#
# SRC-Nginx's authentication.conf proxies to gw.live.surfresearchcloud.nl,
# and nginx resolves upstream hostnames once, at start. A DNS hiccup during
# any restart (unattended-upgrades, logrotate, a reboot) makes the start
# fail with "host not found in upstream", and stock nginx.service never
# retries — the workspace stays down until someone notices. Retry instead.
#
# A separate drop-in file: SRC-Nginx's own override.conf is never touched.
# RestartSec=5s keeps the start rate under systemd's default burst limit
# (5 starts / 10s), so the retries continue until DNS recovers.
[Service]
Restart=on-failure
RestartSec=5s
