# Generated by the ddp-inspector component — do not edit.
# SRAM-gated location for the DDP Inspector, included by SRC-Nginx's server
# block via /etc/nginx/app-location-conf.d/. This file only ever ADDS the
# inspector's own location; other apps' conf files are never touched.
location {{ inspector_base_path }}/ {
    error_page 401 = @custom_401;
    auth_request /validate;                       # SRAM login, CO members only
    auth_request_set $username $upstream_http_username;
    client_max_body_size {{ inspector_upload_max }};
    alias {{ inspector_install_dir }}/public/;
    index index.php;
    location ~ ^{{ inspector_base_path }}/(.+\.php)$ {
        include fastcgi_params;
        fastcgi_pass unix:{{ php_fpm_sock }};
        fastcgi_param SCRIPT_FILENAME {{ inspector_install_dir }}/public/$1;
        fastcgi_param REMOTE_USER $username;
    }
}
